# VAZEDGAME — Environment Variables
# Supabase authentication setup required.
# 1. Create a Supabase project at https://supabase.io
# 2. Go to Project Settings → API
# 3. Copy the values below

# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Your Supabase anon key (public key, safe in frontend)
VITE_SUPABASE_ANON_KEY=

# NOTE: SESSION_SECRET is not required — Supabase manages session tokens securely.
# If you previously added this variable, it is not used by the current implementation.
# Supabase handles cookie signing and session management automatically.

# Optional: For future custom use (not required for current setup)
# SESSION_SECRET=your_random_string_here