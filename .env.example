# VAZEDGAME — Environment Variables
# Supabase authentication setup required.
# 1. Create a Supabase project at https://supabase.io
# 2. Go to Project Settings → API
# 3. Copy the values below

# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Your Supabase anon key (public key, safe in frontend)
VITE_SUPABASE_ANON_KEY=

# SESSION_SECRET: Random secret for cookie signing (keep this secret!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Supabase database password if using remote storage
# SUPABASE_DB_PASSWORD=