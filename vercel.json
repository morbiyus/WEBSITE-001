{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/*.css", "use": "@vercel/static" },
    { "src": "js/*.js", "use": "@vercel/static" },
    { "src": "games/*.js", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "status": 200, "headers": { "Content-Type": "application/json" }, "body": { "success": false, "error": "Bu xidmət hal-hazırda demo rejimindədir və müharibəlidir." } },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
